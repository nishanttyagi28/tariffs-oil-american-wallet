	measure 'Pass-through DiD (pp/yr)' = CALCULATE ( SUM ( 'Pass-through'[Annualised Coef] ), 'Pass-through'[Spec] = "did_main", 'Pass-through'[Term] = "treat_post" )
		formatString: +0.0;-0.0;0.0
		displayFolder: Household
		lineageTag: 199158d9-6230-5d7b-912e-f41395d9cbfc

	measure 'Pass-through DiD Text' =
			VAR _lo = CALCULATE ( SUM ( 'Pass-through'[CI Lo] ), 'Pass-through'[Spec] = "did_main", 'Pass-through'[Term] = "treat_post" ) * 12
			VAR _hi = CALCULATE ( SUM ( 'Pass-through'[CI Hi] ), 'Pass-through'[Spec] = "did_main", 'Pass-through'[Term] = "treat_post" ) * 12
			VAR _p = CALCULATE ( SUM ( 'Pass-through'[P Value] ), 'Pass-through'[Spec] = "did_main", 'Pass-through'[Term] = "treat_post" )
			RETURN "95% CI " & FORMAT ( _lo, "0.0" ) & " to " & FORMAT ( _hi, "0.0" ) & " pp/yr, p = " & FORMAT ( _p, "0.000" )
		displayFolder: Household
		lineageTag: 46771fa6-4b53-520e-a496-226cbfb4067f

	measure 'Event-study Coef (pp/mo)' = CALCULATE ( SUM ( 'Pass-through'[Coef] ), 'Pass-through'[Spec] = "event_study" )
		formatString: 0.00
		displayFolder: Household
		lineageTag: fc0daf26-8577-500d-b72b-fe5e97f8f303

	measure 'Event-study CI Lo' = CALCULATE ( SUM ( 'Pass-through'[CI Lo] ), 'Pass-through'[Spec] = "event_study" )
		formatString: 0.00
