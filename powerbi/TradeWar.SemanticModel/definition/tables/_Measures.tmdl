	measure 'Executive Story' =
			VAR _et = [Effective Tariff Latest %]
			VAR _e24 = [Effective Tariff 2024 %]
			VAR _cn = [China Import Effect ($bn)]
			VAR _hh = [Household Tariff Cost to Date ($)]
			VAR _b = [Brent Latest ($/bbl)]
			VAR _bw = [Brent vs Pre-war %]
			VAR _cpi = [Headline CPI Latest YoY %]
			RETURN "Tariffs: the effective US tariff rate moved from " & FORMAT ( _e24, "0.0%" ) & " in 2024 to " & FORMAT ( _et, "0.0%" ) &
			    " in the latest month. Against a no-tariff counterfactual, imports from China are " & FORMAT ( _cn, "$#,0;-$#,0" ) &
			    "bn since Apr 2025 while Vietnam and Taiwan gained. Households: customs collections above 2024 levels add up to about " &
			    FORMAT ( _hh, "$#,0" ) & " per household. Oil: since the Iran war began on 28 Feb 2026, Brent is at " & FORMAT ( _b, "$0" ) &
			    "/bbl (" & FORMAT ( _bw, "+0%;-0%" ) & " vs pre-war) and headline CPI is " & FORMAT ( _cpi, "0.0%" ) & " YoY."
		displayFolder: Story
		lineageTag: c44d9aad-5baf-5607-ac47-2504e765f332

	measure 'Data Freshness' = "Trade to " & FORMAT ( [Last Trade Month], "mmm yyyy" ) & "  |  markets to " & FORMAT ( CALCULATE ( MAX ( Oil[Date] ), REMOVEFILTERS ( 'Date' ) ), "d mmm yyyy" )
		displayFolder: Story
		lineageTag: 0b3d195b-0018-50af-b202-9d1cc3229426

	measure 'Event-study Title' = "Pass-through event study: exposed goods minus services CPI (pp/month vs quarter -1). DiD " & FORMAT ( [Pass-through DiD (pp/yr)], "+0.0" ) & " pp/yr, " & [Pass-through DiD Text]
