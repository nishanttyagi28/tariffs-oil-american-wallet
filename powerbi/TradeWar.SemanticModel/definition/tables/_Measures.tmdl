table _Measures
	lineageTag: dad67363-213c-5e0a-b998-8d0bfb982adc

	measure 'Imports ($bn)' = DIVIDE ( SUM ( Trade[Imports $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 8f6460a5-b8af-5bad-a605-5f6348cb1849

	measure 'Exports ($bn)' = DIVIDE ( SUM ( Trade[Exports $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: f0473d5a-2404-50c9-8887-242fccca9696

	measure 'Trade Balance ($bn)' = DIVIDE ( SUM ( Trade[Balance $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 0b89cf89-06e1-554d-ba13-5d8649df98d9

	measure 'Total Trade ($bn)' = DIVIDE ( SUM ( Trade[Total Trade $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: a11a6a66-7c8b-5aaf-81eb-50ae4ad734f6

	measure 'Imports LY ($bn)' = CALCULATE ( [Imports ($bn)], DATEADD ( 'Date'[Date], -1, YEAR ) )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 8eab641c-782e-567c-a06e-8cf57a4792ca

	measure 'Exports LY ($bn)' = CALCULATE ( [Exports ($bn)], DATEADD ( 'Date'[Date], -1, YEAR ) )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: d081cb6a-c531-5e64-8c39-3618ee9efc02

	measure 'Imports YoY %' =
			VAR _cy = [Imports ($bn)]
			VAR _ly = [Imports LY ($bn)]
			RETURN IF ( NOT ISBLANK ( _cy ) && NOT ISBLANK ( _ly ), DIVIDE ( _cy - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trade
		lineageTag: 5b5969cb-67e8-5352-8caa-8ad19b35e8c2

	measure 'Exports YoY %' =
			VAR _cy = [Exports ($bn)]
			VAR _ly = [Exports LY ($bn)]
			RETURN IF ( NOT ISBLANK ( _cy ) && NOT ISBLANK ( _ly ), DIVIDE ( _cy - _ly, _ly ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trade
		lineageTag: 01179163-8521-5cc4-9e3d-44a1bdde1886

	measure 'Imports YTD ($bn)' = TOTALYTD ( [Imports ($bn)], 'Date'[Date] )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: c403dba8-3f56-5686-9837-9477d56b53c0

	measure 'Last Trade Month' = CALCULATE ( MAX ( Trade[Month] ), REMOVEFILTERS ( 'Date' ) )
		formatString: mmm yyyy
		displayFolder: Trade
		lineageTag: 71df6bf3-f60e-560c-89e4-7ae91b9f2786

	measure 'Imports Last 12M ($bn)' =
			VAR _m = [Last Trade Month]
			RETURN CALCULATE ( [Imports ($bn)], REMOVEFILTERS ( 'Date' ), 'Date'[Date] > EDATE ( _m, -12 ), 'Date'[Date] <= _m )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 5a96ccaa-b267-5d1a-9610-1adb8801174d

	measure 'Share of US Imports %' = DIVIDE ( [Imports ($bn)], CALCULATE ( [Imports ($bn)], REMOVEFILTERS ( Country ) ) )
		formatString: 0.0%
		displayFolder: Trade
		lineageTag: 4dad6c92-2ceb-5da9-8768-01fc75c590d5

	measure 'Import Rank' = IF ( HASONEVALUE ( Country[Country] ) && NOT ISBLANK ( [Imports ($bn)] ), RANKX ( ALLSELECTED ( Country[Country] ), [Imports ($bn)], , DESC, DENSE ) )
		formatString: #,0
		displayFolder: Trade
		lineageTag: 8536eb73-4410-5633-af1b-864873782824

	measure 'Avg Monthly Imports 2024 ($bn)' = DIVIDE ( CALCULATE ( SUM ( Trade[Imports $M] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ), 12000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 9a537fe7-96e4-5235-8398-d29c6eea6963

	measure 'Avg Monthly Imports After ($bn)' =
			VAR _v = CALCULATE ( SUM ( Trade[Imports $M] ), KEEPFILTERS ( 'Date'[Date] >= DATE ( 2025, 4, 1 ) ) )
			VAR _n = CALCULATE ( DISTINCTCOUNT ( Trade[Month] ), KEEPFILTERS ( 'Date'[Date] >= DATE ( 2025, 4, 1 ) ), REMOVEFILTERS ( Country ) )
			RETURN DIVIDE ( _v, _n * 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 042172aa-b335-5163-b97a-40aad9a775c9

	measure 'Import Change vs 2024 %' =
			VAR _a = [Avg Monthly Imports After ($bn)]
			VAR _b = [Avg Monthly Imports 2024 ($bn)]
			RETURN IF ( _a > 0 && _b > 0, _a / _b - 1 )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trade
		lineageTag: 63dac98a-d9d5-5cea-888b-d377d1f3dc6d

	measure 'Import Change Top 20 %' = IF ( SELECTEDVALUE ( Country[Entity Type] ) = "country" && MIN ( 'Country Before After'[Import Rank Before] ) <= 20, [Import Change vs 2024 %] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trade
		lineageTag: b6be162b-3b59-535f-adb7-0fdcb7ee64e6

	measure 'Map Colour Imports' =
			VAR _x = [Import Change vs 2024 %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _x ) || SELECTEDVALUE ( Country[Entity Type] ) <> "country", BLANK (),
			    _x <= -0.30, "#B23A1E", _x <= -0.10, "#E4572E", _x < 0, "#F4A582", _x < 0.10, "#A6DBD5", _x < 0.30, "#1AA39A", "#0E6B64" )
		displayFolder: Trade
		lineageTag: 36585970-0a29-5f97-a597-fa1fad16452b

	measure 'Selected Trade Metric ($bn)' =
			SWITCH ( SELECTEDVALUE ( 'Trade Metric'[Metric], "Imports" ),
			    "Imports", [Imports ($bn)],
			    "Exports", [Exports ($bn)],
			    "Trade balance", [Trade Balance ($bn)],
			    "Total trade", [Total Trade ($bn)] )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: d45e5d5b-7a45-5e87-a786-cdc3484f61bb

	measure 'Selected Trade Metric LY ($bn)' = CALCULATE ( [Selected Trade Metric ($bn)], DATEADD ( 'Date'[Date], -1, YEAR ) )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: 0ad4adfe-4a16-51b8-a6c2-1298a358bb8a

	measure 'Selected Trade Metric YoY %' =
			VAR _cy = [Selected Trade Metric ($bn)]
			VAR _ly = [Selected Trade Metric LY ($bn)]
			RETURN IF ( NOT ISBLANK ( _ly ), DIVIDE ( _cy - _ly, ABS ( _ly ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Trade
		lineageTag: c90fa835-a493-5822-9f2e-a8d4e2681490

	measure 'Trade Trend Title' =
			SELECTEDVALUE ( 'Trade Metric'[Metric], "Imports" ) & " by month ($bn), " &
			IF ( HASONEVALUE ( Country[Map Name] ), VALUES ( Country[Map Name] ), "all partners" ) & " (with same month last year)"
		displayFolder: Trade
		lineageTag: b1e964c6-ca4d-5a60-8109-518993bc3bdd

	measure 'Diverted Imports ($bn)' = DIVIDE ( SUM ( 'Trade Diversion'[Diverted Imports $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Trade
		lineageTag: ec3aea31-5d22-57a7-b839-d54638ab2205

	measure 'Import Share of Group %' = AVERAGE ( 'Trade Diversion'[Import Share] )
		formatString: 0.0%
		displayFolder: Trade
		lineageTag: 917fba16-74d0-5d6e-8ef1-2a9f7c7332c2

	measure 'Share Change vs 2024 (pp)' = AVERAGE ( 'Trade Diversion'[Share Change pp] )
		formatString: +0.0;-0.0;0.0
		displayFolder: Trade
		lineageTag: 797944c5-3782-5520-91a1-ab5441967dd1

	measure 'Statutory Tariff Rate %' = AVERAGE ( 'Tariff Rate'[Statutory Rate %] )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: beca98ad-ef9f-5b73-babd-f6bf710f063a

	measure 'Peak Statutory Rate %' = MAX ( 'Tariff Rate'[Max Rate in Month %] )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: e37675c4-5305-5327-8df0-17b9e6e09c63

	measure 'Statutory Tariff Latest %' =
			VAR _m = DATE ( YEAR ( TODAY () ), MONTH ( TODAY () ), 1 )
			RETURN CALCULATE ( AVERAGE ( 'Tariff Rate'[Statutory Rate %] ), REMOVEFILTERS ( 'Date' ), 'Tariff Rate'[Month] = _m )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: cdf3b67f-31b1-5374-9db3-330bbbc5ae23

	measure 'Map Colour Tariff' =
			VAR _x = [Peak Statutory Rate %]
			RETURN SWITCH ( TRUE (), ISBLANK ( _x ) || SELECTEDVALUE ( Country[Entity Type] ) <> "country", BLANK (),
			    _x >= 0.5, "#7A2E0E", _x >= 0.3, "#C8553D", _x >= 0.2, "#F2A541", _x >= 0.15, "#F6C985", _x >= 0.1, "#FBE6C2", "#DCE3EE" )
		displayFolder: Tariffs
		lineageTag: 988a5f2d-ccbc-5373-a45b-7a878a3f84fa

	measure 'Customs Gross ($bn)' = DIVIDE ( SUM ( Customs[Gross Receipts $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: 4b691fa0-5cca-5fe5-8508-a36726f8b6f8

	measure 'Customs Refunds ($bn)' = DIVIDE ( SUM ( Customs[Refunds $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: 58b17af2-65b9-5cca-bc1b-a6ab6dbba4d1

	measure 'Customs Net ($bn)' = DIVIDE ( SUM ( Customs[Net Receipts $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: b1261046-5eb1-5294-88f1-ee0fbb741ae6

	measure 'Effective Tariff Rate %' = DIVIDE ( SUM ( Customs[Gross Receipts $M] ), SUM ( Customs[US Imports $M] ) )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: 0b9a48e7-4636-51e3-acaa-4a842196e1cd

	measure 'Effective Tariff Rate Net %' = DIVIDE ( SUM ( Customs[Net Receipts $M] ), SUM ( Customs[US Imports $M] ) )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: 116a52ba-2d27-57df-af20-a288e71ed6de

	measure 'Effective Tariff Latest %' =
			VAR _last = CALCULATE ( MAX ( Customs[Month] ), REMOVEFILTERS ( 'Date' ), FILTER ( ALL ( Customs[Effective Rate Gross %] ), NOT ISBLANK ( Customs[Effective Rate Gross %] ) ) )
			RETURN CALCULATE ( [Effective Tariff Rate %], REMOVEFILTERS ( 'Date' ), Customs[Month] = _last )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: 0ba9dc24-c8d0-50e0-9702-7cc18b2d8bed

	measure 'Effective Tariff 2024 %' = CALCULATE ( [Effective Tariff Rate %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: 0.0%
		displayFolder: Tariffs
		lineageTag: ac80ae4c-fbf5-5925-9d5d-6749c3618072

	measure 'Effective Tariff Change (pp)' = ( [Effective Tariff Latest %] - [Effective Tariff 2024 %] ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: Tariffs
		lineageTag: c2ed3526-24e2-5c25-a570-d1f4d4666828

	measure 'Incremental Customs vs 2024 ($bn)' = DIVIDE ( SUM ( Customs[Incremental Net vs 2024 $M] ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: c7559e9f-709e-5e9f-b920-f55f74090f84

	measure 'Cumulative Incremental Customs ($bn)' =
			VAR _d = MAX ( 'Date'[Date] )
			RETURN IF ( _d >= DATE ( 2025, 2, 1 ), DIVIDE ( CALCULATE ( SUM ( Customs[Incremental Net vs 2024 $M] ), REMOVEFILTERS ( 'Date' ),
			    Customs[Month] >= DATE ( 2025, 2, 1 ), Customs[Month] <= _d ), 1000 ) )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: f147c810-3269-5b75-8f10-474c92975427

	measure 'Customs Windfall to Date ($bn)' = DIVIDE ( CALCULATE ( SUM ( Customs[Incremental Net vs 2024 $M] ), REMOVEFILTERS ( 'Date' ), Customs[Month] >= DATE ( 2025, 2, 1 ) ), 1000 )
		formatString: $#,0.0;-$#,0.0;$0.0
		displayFolder: Tariffs
		lineageTag: 98312b08-be14-5ee4-85ba-46720e1bb688

	measure 'Tariff Events (#)' = CALCULATE ( COUNTROWS ( Events ), Events[Event Family] = "Tariff" )
		formatString: #,0
		displayFolder: Tariffs
		lineageTag: a9c9a8bf-1392-520c-b653-60f8405c0c0e

	measure 'War Events (#)' = CALCULATE ( COUNTROWS ( Events ), Events[Event Family] = "Iran war" )
		formatString: #,0
