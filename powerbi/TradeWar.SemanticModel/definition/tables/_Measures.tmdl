		lineageTag: 64a7ba69-7dbe-58d8-a03c-dec3a726ce5b

	measure 'Tariff Cost per Household ($/mo)' = SUM ( Customs[Incremental Gross per Household USD] )
		formatString: $#,0
		displayFolder: Household
		lineageTag: 46e77cb0-ca74-5c8f-a63c-32f499f8808a

	measure 'Household Tariff Cost to Date ($)' = CALCULATE ( SUM ( Customs[Incremental Gross per Household USD] ), REMOVEFILTERS ( 'Date' ), Customs[Month] >= DATE ( 2025, 2, 1 ) )
		formatString: $#,0
		displayFolder: Household
		lineageTag: af3003b1-4cf1-5c8a-bb12-cd2a8594a00a

	measure 'Cumulative Tariff Cost per Household ($)' =
			VAR _d = MAX ( 'Date'[Date] )
			RETURN IF ( _d >= DATE ( 2025, 2, 1 ), CALCULATE ( SUM ( Customs[Incremental Gross per Household USD] ), REMOVEFILTERS ( 'Date' ),
			    Customs[Month] >= DATE ( 2025, 2, 1 ), Customs[Month] <= _d ) )
		formatString: $#,0
		displayFolder: Household
		lineageTag: 39a02b85-81ec-5e26-83d6-42e1f3cf181e

	measure 'CPI YoY %' = AVERAGE ( CPI[YoY %] )
		formatString: 0.0%
		displayFolder: Household
		lineageTag: c9ee0c17-1df6-5176-9fcb-04685fd15b0a

	measure 'CPI YoY Latest %' =
			VAR _last = CALCULATE ( MAX ( CPI[Month] ), REMOVEFILTERS ( 'Date' ), FILTER ( ALL ( CPI[YoY %] ), NOT ISBLANK ( CPI[YoY %] ) ) )
			RETURN CALCULATE ( AVERAGE ( CPI[YoY %] ), REMOVEFILTERS ( 'Date' ), CPI[Month] = _last )
		formatString: 0.0%
		displayFolder: Household
		lineageTag: 77446ce2-4f47-562d-9075-355e0cc8f968

	measure 'CPI Change since Jan 2025 %' =
			VAR _last = CALCULATE ( MAX ( CPI[Month] ), REMOVEFILTERS ( 'Date' ), FILTER ( ALL ( CPI[Change since Jan2025 %] ), NOT ISBLANK ( CPI[Change since Jan2025 %] ) ) )
			RETURN CALCULATE ( AVERAGE ( CPI[Change since Jan2025 %] ), REMOVEFILTERS ( 'Date' ), CPI[Month] = _last )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Household
		lineageTag: d5c2baf4-9132-5049-8293-5d2a7b558c6f

	measure 'Exposure Colour' =
