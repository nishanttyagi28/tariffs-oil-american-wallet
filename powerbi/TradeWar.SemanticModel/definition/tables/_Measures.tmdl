	measure 'DD Title' = "Country deep-dive: " & [DD Partner] & IF ( ISFILTERED ( Partner[Partner] ) || ISFILTERED ( Partner[Partner Code] ), "", " (default; pick a partner or drill through from any partner chart)" )
		displayFolder: Deep-dive
