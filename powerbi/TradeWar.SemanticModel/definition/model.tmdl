model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataRoot", "Date", "Country", "CPI Category", "Instrument", "Chokepoint", "Trade", "Tariff Rate", "Customs", "CPI", "Macro", "Market", "Oil", "Chokepoint Daily", "Country Before After", "Trade Diversion", "Household", "Oil Shock", "Events", "Partner", "Trade Metric", "Counterfactual", "Tariff Effect", "Model Metrics", "Pass-through", "Event Study", "IRF", "Vol Regimes", "Forecasts", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Country
ref table 'CPI Category'
ref table Instrument
ref table Chokepoint
ref table Trade
ref table 'Tariff Rate'
ref table Customs
ref table CPI
ref table Macro
ref table Market
ref table Oil
ref table 'Chokepoint Daily'
ref table 'Country Before After'
ref table 'Trade Diversion'
ref table Household
ref table 'Oil Shock'
ref table Events
ref table Partner
ref table 'Trade Metric'
ref table Counterfactual
ref table 'Tariff Effect'
ref table 'Model Metrics'
ref table 'Pass-through'
ref table 'Event Study'
ref table IRF
ref table 'Vol Regimes'
ref table Forecasts
ref table _Measures
