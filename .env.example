# Copy this file to .env (gitignored, never commit it). Every variable is OPTIONAL:
# the project runs end to end on public data with no keys at all.

# US Census Bureau API key (free: https://api.census.gov/data/key_signup.html).
# If set, `python -m ingest.census_hs` also pulls HS-chapter x country x duty data; otherwise it is skipped.
CENSUS_API_KEY=

# Optional overrides (normally leave unset):
# TRADEWAR_DB=warehouse/tradewar.duckdb   # DuckDB file used by dbt, ml, tests
# TRADEWAR_RAW=E:/path/to/repo/data/raw   # absolute raw-data path if you run dbt from outside dbt/
