# Python / envs
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
# secrets
.env
# data: raw snapshots (data/raw) and the DuckDB warehouse ARE committed so a fresh clone reproduces everything.
# Only exploratory source probes and DuckDB write-ahead/temp files are ignored.
data/_probe/
warehouse/*.duckdb.wal
# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/
logs/
# Power BI local caches
powerbi/**/.pbi/localSettings.json
powerbi/**/.pbi/cache.abf
dbt/.user.yml
warehouse/*.tmp
warehouse/*.duckdb.tmp

.scratch/
# Power BI Desktop-written artifacts (the generator is the source of truth)
powerbi/**/.pbi/editorSettings.json
powerbi/**/diagramLayout.json
powerbi/**/definition/cultures/
